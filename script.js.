function reconstruirPantalla() {
    const box = document.getElementById("chat-box");
    if (!box) return;
    box.innerHTML = "";
    historial.forEach(function(m) {
        const div = document.createElement("div");
        div.className = "msg " + (m.role === 'user' ? 'user' : 'neox');
        const pfx = m.role === 'user' ? 'CREADOR' : 'NeoX';
        div.innerHTML = '<span class="prefix">[' + pfx + ']</span>' + m.text;
        box.appendChild(div);
    });
    box.scrollTop = box.scrollHeight;
}

function efectoEscribir(prefix, texto, tipo) {
    const box = document.getElementById("chat-box");
    if (!box) return;
    const div = document.createElement("div");
    div.className = "msg " + tipo;
    div.innerHTML = '<span class="prefix">[' + prefix + ']</span><span class="text-body"></span>';
    box.appendChild(div);
    let i = 0;
    const span = div.querySelector(".text-body");
    function escribir() {
        if (i < texto.length) {
            span.innerHTML += texto.charAt(i);
            i++;
            box.scrollTop = box.scrollHeight;
            setTimeout(escribir, 12);
        }
    }
    escribir();
}

function actualizarBovedaVisual() {
    const contenedor = document.getElementById("memory-vault-list");
    if (!contenedor) return;
    contenedor.innerHTML = "";
    const memoriasFiltro = historial.filter(function(m) { return m.role === 'model'; }).slice(-5);
    if (memoriasFiltro.length === 0) {
        contenedor.innerHTML = '<div style="font-size:0.75em; color:rgba(0,240,255,0.4); text-align:center; padding-top:20px;">Bancos de memoria vacíos.</div>';
        return;
    }
    memoriasFiltro.forEach(function(m, index) {
        const div = document.createElement("div");
        div.className = "memory-item";
        const fragmento = m.text.length > 60 ? m.text.substring(0, 57) + "..." : m.text;
        div.innerHTML = '<span>[REC_0' + (index + 1) + '_INDEX]</span>' + fragmento;
        contenedor.appendChild(div);
    });
}

window.enviarMensaje = async function() {
    const input = document.getElementById("user-input");
    if (!input) return;
    const texto = input.value.trim();
    if (!texto) return;
    
    input.value = "";
    historial.push({ role: "user", text: texto });
    reconstruirPantalla();
    
    document.getElementById("thinking-indicator").style.display = "block";
    document.querySelectorAll(".bar").forEach(function(b) { b.style.animationDuration = "0.15s"; });
    
    const promptContexto = "Actua como NeoX, un asistente de IA inteligente, con personalidad como JARVIS de Iron Man. Responde de forma brillante y directa. Historial: " + JSON.stringify(historial.slice(-8)) + " \nMensaje del creador: " + texto;
    await procesarPeticion(promptContexto);
};

async function procesarPeticion(promptContexto) {
    // ENLACE COMPATIBLE HTTP DIRECTO: Cambiamos el SDK moderno por un Fetch tradicional compatible con navegadores antiguos
    const urlGemini = "https://googleapis.com" + claves[idxActual];
    
    // PASARELA INTERNACIONAL CORREGIDA: Codifica de forma limpia evitando bloqueos CORS corporativos
    const urlApi = "https://allorigins.win" + encodeURIComponent(urlGemini);
    const datosEnvio = { contents: [{ parts: [{ text: promptContexto }] }] };

    try {
        const r = await fetch(urlApi, { 
            method: "POST", 
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
                url: urlGemini,
                method: "POST",
                headers: { "Content-Type": "application/json" },
                data: JSON.stringify(datosEnvio)
            })
        });
        
        document.getElementById("thinking-indicator").style.display = "none";
        document.querySelectorAll(".bar").forEach(function(b) { b.style.animationDuration = "0.8s"; });
        
        if (r.status === 200) {
            const wrapper = await r.json();
            const jsonRespuesta = JSON.parse(wrapper.contents);
            const txt = jsonRespuesta.candidates[0].content.parts[0].text;
            
            historial.push({ role: "model", text: txt });
            localStorage.setItem("neox_web_history", JSON.stringify(historial));
            
            efectoEscribir("NeoX", txt, "neox");
            actualizarBovedaVisual();
            actualizarNeuronasRecientes(txt);
        } else if (r.status === 429 || r.status === 403) {
            if (idxActual < claves.length - 1) {
                idxActual++;
                const coreIndicator = document.getElementById("active-core");
                if (coreIndicator) coreIndicator.innerText = "NÚCLEO_ACTIVO: [0" + (idxActual + 1) + "]";
                await procesarPeticion(promptContexto);
            } else { alert("ALERTA: Bancos de energía agotados."); }
        } else { alert("Error de enlace HTTP: " + r.status); }
    } catch (err) {
        document.getElementById("thinking-indicator").style.display = "none";
        alert("Desviación cuántica de red: " + err);
    }
}
