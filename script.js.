function reconstruirPantalla() {
    const box = document.getElementById("chat-box");
    if (!box) return;
    box.innerHTML = "";
    historial.forEach(m => {
        const div = document.createElement("div");
        div.className = "msg " + (m.role === 'user' ? 'user' : 'neox');
        const pfx = m.role === 'user' ? 'CREADOR' : 'NeoX';
        div.innerHTML = '<span class="prefix">[' + pfx + ']</span>' + m.text;
        box.appendChild(div);
    });
    box.scrollTop = box.scrollHeight;
}

function efectoEscribir(prefix, texto, tipo) {
    const box = document.getElementById("chat-box");
    if (!box) return;
    const div = document.createElement("div");
    div.className = "msg " + tipo;
    div.innerHTML = '<span class="prefix">[' + prefix + ']</span><span class="text-body"></span>';
    box.appendChild(div);
    let i = 0;
    const span = div.querySelector(".text-body");
    function escribir() {
        if (i < texto.length) {
            span.innerHTML += texto.charAt(i);
            i++;
            box.scrollTop = box.scrollHeight;
            setTimeout(escribir, 12);
        }
    }
    escribir();
}

// Actualización en tiempo real de la base de datos visual en la pantalla de la Red Neuronal
function actualizarBovedaVisual() {
    const contenedor = document.getElementById("memory-vault-list");
    if (!contenedor) return;
    contenedor.innerHTML = "";
    
    // Extraer las últimas 5 interacciones clave para el contexto visible de recuerdos
    const memoriasFiltro = historial.filter(m => m.role === 'model').slice(-5);
    if (memoriasFiltro.length === 0) {
        contenedor.innerHTML = '<div class="profile-meta" style="font-size:0.75em; color:rgba(0,240,255,0.4); text-align:center; padding-top:20px;">Bancos de memoria vacíos.</div>';
        return;
    }
    
    memoriasFiltro.forEach((m, index) => {
        const div = document.createElement("div");
        div.className = "memory-item";
        const fragmento = m.text.length > 60 ? m.text.substring(0, 57) + "..." : m.text;
        div.innerHTML = `<span>[REC_0${index + 1}_INDEX]</span>${fragmento}`;
        contenedor.appendChild(div);
    });
}

window.enviarMensaje = async function() {
    const input = document.getElementById("user-input");
    if (!input) return;
    const texto = input.value.trim();
    if (!texto) return;
    
    input.value = "";
    historial.push({ role: "user", text: texto });
    reconstruirPantalla();
    
    document.getElementById("thinking-indicator").style.display = "block";
    document.querySelectorAll(".bar").forEach(b => b.style.animationDuration = "0.15s");
    
    // Inyección estricta del prompt de comportamiento nativo para emular a J.A.R.V.I.S.
    const promptContexto = "Actua como NeoX, un asistente de IA inteligente, brillante y sofisticado, con una personalidad exacta a JARVIS de Iron Man. Responde con genialidad y de forma directa. Historial de sesion previo: " + JSON.stringify(historial.slice(-8)) + " \nMensaje actual del creador: " + texto;
    await procesarPeticion(promptContexto);
};
