async function procesarPeticion(promptContexto) {
    try {
        // LLAMADA OFICIAL DIRECTA MEDIANTE SDK NATIVO: Evita CORS y bloqueos de red
        const model = ai.models.getGenerativeModel({ model: "gemini-1.5-flash" });
        const respuesta = await model.generateContent({ contents: promptContexto });
        const resultadoTexto = respuesta.text;

        document.getElementById("thinking-indicator").style.display = "none";
        document.querySelectorAll(".bar").forEach(b => b.style.animationDuration = "0.8s");

        historial.push({ role: "model", text: resultadoTexto });
        localStorage.setItem("neox_web_history", JSON.stringify(historial));
        
        // Actualizar los módulos del sistema operativo en vivo
        efectoEscribir("NeoX", resultadoTexto, "neox");
        actualizarBovedaVisual();
        actualizarNeuronasRecientes(resultadoTexto);

    } catch (err) {
        console.error("Fallo de núcleo de energía: ", err);
        
        // Sistema automático de rotación cuántica si el núcleo actual agota su cuota
        if (idxActual < claves.length - 1) {
            idxActual++;
            const coreIndicator = document.getElementById("active-core");
            if (coreIndicator) coreIndicator.innerText = "NÚCLEO_ACTIVO: [0" + (idxActual + 1) + "]";
            
            // Re-inicializar el SDK nativo con el núcleo de respaldo
            ai = new GoogleGenAI({ apiKey: claves[idxActual] });
            await procesarPeticion(promptContexto);
        } else {
            document.getElementById("thinking-indicator").style.display = "none";
            alert("ALERTA GENERAL: Todos los bancos de energía de la bóveda han agotado su cuota global.");
        }
    }
}

// ARQUITECTURA GRÁFICA DE LA RED NEURONAL INTERACTIVA AVANZADA
const canvas = document.getElementById("neuralNet");
const ctx = canvas.getContext("2d");
let nodos = [];
const totalNodos = 50; // Densidad expandida de nodos para aumentar la capacidad visual

// Físicas táctiles avanzadas: Matrices de rotación, Zoom (Fov) y Arrastre con el dedo
let angY = 0.003, angX = 0.001;
let isDragging = false;
let previousMousePosition = { x: 0, y: 0 };
let fov = 130; // Control de expansión y zoom interactivo
let seleccionadoIndex = null; // Nodo decodificado actual

// Lista base de memorias del núcleo ciberpunk
let labelsBase = ["NeoX_Core", "JARVIS_Matrix", "Quantum_Vault", "Memory_JSON", "Google_1.5", "Cyberpunk_UI", "User_Carlos", "Synapse_v11", "Cortex_Link", "Data_Stream"];

function resCanvas() {
    if (!canvas || !canvas.parentNode) return;
    canvas.width = canvas.parentNode.clientWidth;
    canvas.height = canvas.parentNode.clientHeight - 40;
}
window.addEventListener('resize', resCanvas);
setTimeout(resCanvas, 200);

// Generador de esfera tridimensional densa
for (let i = 0; i < totalNodos; i++) {
    let u = Math.random(), v = Math.random();
    let theta = u * 2 * Math.PI;
    let phi = Math.acos(2 * v - 1);
    let r = 90; // Radio de órbita esférica
    nodos.push({
        x: r * Math.sin(phi) * Math.cos(theta),
        y: r * Math.sin(phi) * Math.sin(theta),
        z: r * Math.cos(phi),
        label: i < labelsBase.length ? labelsBase[i] : null,
        desc: i < labelsBase.length ? "Registro de sistema indexado en sector de arranque." : null
    });
}
