// APRENDIZAJE ADAPTATIVO EN VIVO: Extrae palabras de NeoX y las asienta en la red
function actualizarNeuronasRecientes(textoRespuesta) {
    let palabras = textoRespuesta.split(" ").filter(w => w.length > 5 && w.length < 11);
    if (palabras.length > 0) {
        // Buscar un nodo vacío para enseñarle la palabra
        let nodosVacios = nodos.filter(n => !n.label);
        let objetivo = nodosVacios.length > 0 ? nodosVacios[Math.floor(Math.random() * nodosVacios.length)] : nodos[Math.floor(Math.random() * nodos.length)];
        let palabraLimpia = palabras[Math.floor(Math.random() * palabras.length)].replace(/[^a-zA-Z]/g, "").toUpperCase();
        if (palabraLimpia) {
            objetivo.label = palabraLimpia;
            objetivo.desc = "Concepto adquirido de forma autonoma durante el analisis del ultimo requerimiento táctico.";
        }
    }
}

// CAPTURA DE EVENTOS TÁCTILES Y RATÓN (ARRANQUE DE ROTACIÓN MANUAL Y CLICS)
if (canvas) {
    // Soporte para PC y Tablet (Eventos unificados)
    canvas.addEventListener('mousedown', iniciarArrastre);
    canvas.addEventListener('touchstart', (e) => iniciarArrastre(e.touches[0]), { passive: true });
    window.addEventListener('mousemove', moverArrastre);
    window.addEventListener('touchmove', (e) => moverArrastre(e.touches[0]), { passive: true });
    window.addEventListener('mouseup', detenerArrastre);
    window.addEventListener('touchend', detenerArrastre);
    canvas.addEventListener('wheel', procesarZoom);
}

function iniciarArrastre(e) {
    isDragging = true;
    const rect = canvas.getBoundingClientRect();
    previousMousePosition = { x: e.clientX - rect.left, y: e.clientY - rect.top };
    procesarClickNodo(e.clientX - rect.left, e.clientY - rect.top);
}

function moverArrastre(e) {
    if (!isDragging) return;
    const rect = canvas.getBoundingClientRect();
    const currentX = e.clientX - rect.left;
    const currentY = e.clientY - rect.top;
    
    // Convertir el desplazamiento del dedo en velocidad angular esférica
    angY = (currentX - previousMousePosition.x) * 0.005;
    angX = (currentY - previousMousePosition.y) * 0.005;
    
    previousMousePosition = { x: currentX, y: currentY };
}

function detenerArrastre() {
    isDragging = false;
    // Retorno suave a la órbita inercial automática de NeoX
    setTimeout(() => {
        if (!isDragging) { angY = 0.002; angX = 0.001; }
    }, 1500);
}

// ZOOM INTERACTIVO POR PELLIZCO O RUEDA DE RATÓN
function procesarZoom(e) {
    e.preventDefault();
    fov += e.deltaY * 0.1;
    fov = Math.max(50, Math.min(250, fov)); // Límites de seguridad del visor óptico
}

// DETECTOR DE INTERACCIÓN SOBRE NODOS (DECISIONES TÁCTILES)
function procesarClickNodo(mx, my) {
    const cx = canvas.width / 2, cy = canvas.height / 2;
    let nodoDetectado = null;
    let distanciaMinima = 15; // Margen de error para el toque del dedo

    nodos.forEach((n, index) => {
        let e = fov / (fov + n.z);
        let nx = cx + n.x * e;
        let ny = cy + n.y * e;
        let dist = Math.sqrt(Math.pow(mx - nx, 2) + Math.pow(my - ny, 2));
        if (dist < distanciaMinima && n.label) {
            distanciaMinima = dist;
            nodoDetectado = n;
            seleccionadoIndex = index;
        }
    });

    const panelHud = document.getElementById("card-content");
    if (panelHud && nodoDetectado) {
        panelHud.innerHTML = `<span><strong>ID_NODO:</strong> [N_0${seleccionadoIndex}]</span><br>
                              <span><strong>ETIQUETA:</strong> ${nodoDetectado.label}</span><br>
                              <span><strong>STATUS:</strong> Activo / Enlazado</span><br>
                              <span><strong>DATO:</strong> ${nodoDetectado.desc || "Célula de contexto cognitivo vacía."}</span>`;
    }
}

// MATRIZ DE ROTACIÓN TRIDIMENSIONAL
function rotar() {
    let cY = Math.cos(angY), sY = Math.sin(angY), cX = Math.cos(angX), sX = Math.sin(angX);
    nodos.forEach(n => {
        let x1 = n.x * cY - n.z * sY, z1 = n.z * cY + n.x * sY;
        let y2 = n.y * cX - z1 * sX, z2 = z1 * cX + n.y * sX;
        n.x = x1; n.y = y2; n.z = z2;
    });
}

// BUCLE DE FOTOGRAMAS DINÁMICOS EN VIVO
function render() {
    if (!canvas || !ctx) return;
    if (canvas.width === 0) resCanvas();
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    rotar();
    
    const cx = canvas.width / 2, cy = canvas.height / 2;
    
    // Renderizado de hilos de sinapsis interconectados
    ctx.strokeStyle = "rgba(0, 240, 255, 0.12)";
    ctx.lineWidth = 1;
    for (let i = 0; i < nodos.length; i++) {
        for (let j = i + 1; j < nodos.length; j++) {
            let dist = Math.sqrt(Math.pow(nodos[i].x - nodos[j].x, 2) + Math.pow(nodos[i].y - nodos[j].y, 2));
            if (dist < 85) {
                let si = fov / (fov + nodos[i].z), sj = fov / (fov + nodos[j].z);
                ctx.beginPath();
                ctx.moveTo(cx + nodos[i].x * si, cy + nodos[i].y * si);
                ctx.lineTo(cx + nodos[j].x * sj, cy + nodos[j].y * sj);
                ctx.stroke();
            }
        }
    }
    
    // Renderizado de núcleos neuronales y textos espaciales
    nodos.forEach((n, idx) => {
        let e = fov / (fov + n.z);
        let x = cx + n.x * e;
        let y = cy + n.y * e;
        let rd = Math.max(1, 3 * e);
        let al = (fov - n.z) / (2 * fov);
        
        if (idx === seleccionadoIndex) {
            ctx.fillStyle = "var(--red)"; // Destacar nodo seleccionado actual
            rd = rd * 1.5;
        } else {
            ctx.fillStyle = n.label ? "rgba(0, 255, 102, " + (al + 0.4) + ")" : "rgba(0, 240, 255, " + al + ")";
        }
        
        ctx.beginPath();
        ctx.arc(x, y, rd, 0, 2 * Math.PI);
        ctx.fill();
        
        if (n.label && n.z < 25) {
            ctx.fillStyle = "rgba(230, 237, 243, " + (al + 0.3) + ")";
            ctx.font = Math.max(7, 9 * e) + "px 'Share Tech Mono'";
            ctx.fillText("[" + n.label + "]", x + 6, y + 3);
        }
    });
    
    // Modulación dinámica de barras analíticas en BRAIN_ACT
    const indicadorPorcentaje = document.getElementById("load-percentage");
    if (indicadorPorcentaje) indicadorPorcentaje.innerText = Math.floor(94 + Math.random() * 7) + "%";
    
    requestAnimationFrame(render);
}

// Disparador inicial absoluto de la interfaz gráfica
requestAnimationFrame(render);
